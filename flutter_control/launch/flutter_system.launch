<?xml version="1.0"?>
<launch>
  <!-- Camera Node -->
  <include file="$(find pylon_camera)/launch/pylon_camera_node.launch" />
  
  <!-- Wait a bit for camera to initialize -->
  <arg name="camera_warmup" default="2.0"/>
  
  <!-- Optic Flow Node -->
  <node pkg="optic_flow_example" 
        type="optic_flow_lucas_kanade.py" 
        name="optic_flow_node" 
        output="screen"
        args="--topic /pylon_camera_node/image_raw"
        launch-prefix="bash -c 'sleep $(arg camera_warmup); $0 $@' ">
  </node>
  
  <!-- Optional: Automatically launch live control -->
  <arg name="auto_control" default="false"/>
  <node pkg="flutter_control" 
        type="run_live_control.py" 
        name="flutter_control_node" 
        output="screen"
        if="$(arg auto_control)"/>
</launch>